# Every setting; env vars override config.yaml (see config.example.yaml). Copy to .env for local use.
# HTTP listen port
PORT=3000
# The single immutable development user id
DEV_USER_ID=dev-user
# Root directory for stored data
DATA_ROOT=./data
# SQLite database file
DB_PATH=./data/journaletto.db
# Model provider: fake | local | external
PROVIDER=fake
# Max retries (after the first attempt) for background processing, with exponential backoff
MAX_RETRIES=3
# Number of concurrent background processing workers
WORKER_CONCURRENCY=1
# Max size of one journal entry in bytes
MAX_ENTRY_BYTES=102400
# Ollama adapter (PROVIDER=local)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0
# Optional path to a YAML config file (default ./config.yaml if present)
# CONFIG_FILE=config.yaml
# Build metadata reported by /healthz (set by the Docker build)
# VERSION=dev
# COMMIT=unknown
