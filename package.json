{
  "name": "journaletto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "go run ./cmd/journaletto",
    "build": "go build -o bin/journaletto ./cmd/journaletto",
    "start": "go run ./cmd/journaletto",
    "format": "prettier --write .",
    "test": "go test ./...",
    "test:smoke": "bash scripts/smoke.sh",
    "check": "go vet ./... && go test ./...",
    "pipeline-check": "bash scripts/pipeline-check.sh",
    "board": "node scripts/board.mjs",
    "log": "node scripts/log.mjs",
    "tokens": "ccusage daily",
    "tokens:session": "ccusage session",
    "tokens:blocks": "ccusage blocks --live"
  },
  "devDependencies": {
    "ccusage": "latest",
    "prettier": "^3.0.0"
  }
}
