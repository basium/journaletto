{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npx *)",
      "Bash(node scripts/*)",
      "Bash(bash scripts/pipeline-check.sh*)",
      "Bash(docker *)",
      "Bash(curl -fsS *)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git switch *)",
      "Bash(git pull --ff-only*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin main)",
      "Bash(git push origin task/*)",
      "Bash(git push origin env/*)",
      "Bash(git push --force-with-lease origin task/*)",
      "Bash(git push --force-with-lease origin env/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh api repos/*/pulls/*)",
      "Bash(gh repo view*)"
    ],
    "ask": ["Bash(git push *)", "Bash(npm install *)"],
    "deny": [
      "Bash(gh pr merge *)",
      "Read(./GUIDE.md)",
      "Read(./BOILERPLATE_SPEC.md)",
      "Read(./.claude/Kanban/log.md)",
      "Read(./.claude/Kanban/archive/**)",
      "Read(./.claude/history/**)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./package-lock.json)",
      "Read(./.env)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_NUDGE_TOKENS": "80000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/quiet-bash.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-nudge.mjs\"" }] }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-history.mjs\"" }]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "npx --no-install ccusage statusline", "padding": 0 },
  "extraKnownMarketplaces": {
    "building-with-jev": { "source": { "source": "github", "repo": "dbreunig/building-with-jev-skill" } }
  },
  "enabledPlugins": { "jev@building-with-jev": true }
}
